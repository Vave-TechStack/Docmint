# ─── DocMint Environment Configuration ───

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DocMint
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docmint?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth
AUTH_SECRET="your-auth-secret-here-min-32-chars-long"
AUTH_URL="http://localhost:3000"

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# AI / OpenAI
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@docmint.com"

# Storage (AWS S3 / Cloudflare R2)
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="docmint-uploads"
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"

# JWT
JWT_SECRET="your-jwt-secret-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"

# Encryption
ENCRYPTION_KEY="your-32-byte-encryption-key"

# SMS (Twilio / MSG91)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Admin
ADMIN_EMAIL="admin@docmint.com"
ADMIN_PASSWORD="admin-password-here"

# Features
ENABLE_AI=true
ENABLE_2FA=true
ENABLE_CACHING=true
