# ─── DocMint Environment Configuration ───
# 🔴 REQUIRED = the app is broken in production without it (verified at startup)
# 🟢 Optional = has a safe fallback

# ─── Application ───
# 🟢 Production email links use this. Set to https://your-domain.com in prod.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DocMint

# ─── Database ───
# 🔴 REQUIRED — the app cannot run without it.
# Use a direct Postgres connection string (Supabase/Neon/RDS all work).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docmint?schema=public"

# ─── NextAuth ───
# 🔴 REQUIRED — encrypts session cookies and powers the proxy auth gate.
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here-min-32-chars-long"

# ─── OAuth Providers (optional but recommended) ───
# 🔴 REQUIRED if you want the Google / Microsoft buttons on the login page.
# Google Cloud Console → Authorized redirect URI:
#   https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Microsoft Azure Portal (App Registration) → Redirect URI:
#   https://your-domain.com/api/auth/callback/microsoft-entra-id
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ─── Razorpay (payments) ───
# 🔴 REQUIRED — subscriptions and instant downloads are paid features.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# 🔴 REQUIRED — used to verify webhook signatures. Must match the webhook
# secret configured in the Razorpay Dashboard.
RAZORPAY_WEBHOOK_SECRET=""

# ─── Email (Resend) ───
# 🔴 REQUIRED — email verification, password reset, and forgot-password all
# depend on this. Get a key at https://resend.com and verify your domain
# so you can send from your own address.
RESEND_API_KEY=""
# 🟢 Must be a domain you verified in Resend (default falls back to noreply@docmint.com,
# which will be rejected unless docmint.com is verified in your Resend account).
RESEND_FROM_EMAIL="noreply@your-domain.com"

# ─── Admin (used by the seed script) ───
ADMIN_EMAIL="admin@docmint.com"
ADMIN_PASSWORD="admin-password-here"

# ─── Support ───
# 🟢 Recommended — used as the reply-to / contact address on emails.
SUPPORT_EMAIL="support@your-domain.com"
